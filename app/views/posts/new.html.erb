<h1>新規投稿</h1>
<%= form_with model: @post, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :content, "投稿内容" %><br>
    <%= f.text_area :content %>
  </div>
  <div>
    <%= f.label :image, "画像" %><br>
    <%= f.file_field :image %>
  </div>
  <%= f.submit "投稿する" %>
<% end %>
