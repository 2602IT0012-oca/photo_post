<h1>投稿詳細</h1>

<p><strong>タイトル：</strong><%= @post.title %></p>
<p><strong>投稿内容：</strong><%= @post.content %></p>

<p><strong>画像：</strong></p>
<div>
  <!-- 詳細ページの画像サイズは 600 x 600 -->
  <% if @post.image.attached? %>
    <%= image_tag @post.image, size: "600x600", style: "border: 1px solid #ccc;" %>
  <% end %>
</div>

<br>
<div>
  <%= link_to "投稿一覧へ戻る", posts_path %>
</div>
