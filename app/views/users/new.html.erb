<h1>サインアップ</h1>

<%= form_with model: @user, url: signup_path, local: true do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :avatar, "アイコン画像" %><br>
    <%= f.file_field :avatar %>
  </div>

  <div>
    <%= f.label :password, "パスワード (6 characters minimum)" %><br>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "パスワードの確認" %><br>
    <%= f.password_field :password_confirmation %>
  </div>

  <br>
  <%= f.submit "サインアップ" %>
<% end %>

<br>
<%= link_to "ログイン", login_path %>
