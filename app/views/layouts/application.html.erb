<!DOCTYPE html>
<html>
  <head>
    <title>PhotoPost</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    
    <style>
      .header-bar {
        background-color: #0052cc;
        padding: 10px 20px;
        display: flex;
        justify-content: center;
        gap: 40px;
      }
      .header-bar a {
        color: white;
        text-decoration: none;
        font-weight: bold;
      }
      .header-bar a:hover {
        text-decoration: underline;
      }
      .container {
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }
    </style>
  </head>

  <body>
    <!-- ログイン状態によってヘッダーのリンクを切り替え -->
    <div class="header-bar">
      <% if logged_in? %>
        <%= link_to "新規投稿", new_post_path %>
        <%= link_to "投稿一覧", posts_path %>
        <%= link_to "マイページ", user_path %>
        <%= button_to "ログアウト", logout_path, method: :delete, style: "background: none; border: none; color: white; font-weight: bold; cursor: pointer; font-size: 16px; padding: 0;" %>

      <% else %>
        <%= link_to "サインアップ", signup_path %>
        <%= link_to "ログイン", login_path %>
      <% end %>
    </div>

    <div class="container">
      <% if flash[:notice] %>
        <p style="color: green;"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p style="color: red;"><%= flash[:alert] %></p>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>

